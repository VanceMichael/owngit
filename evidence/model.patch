+	if code, _ := checkStatus(t, adminAPIRequest(t, http.MethodPut, base+"/plans/other", map[string]any{"destination": second, "keep": 3, "verify": "off", "scheduled": "off"}, "admin-password")); code != http.StatusCreated {
